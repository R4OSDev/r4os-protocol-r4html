R4OS_MODULE_MANIFEST=2
KIND=R4P
NAME=R4HTML
VERSION=0.2.1
LANGUAGE=Zig
SOURCE=src/main.zig
TARGET=/R4OS/PROTOCOLS/R4HTML.R4P
IMAGE_SCOPE=full
IMPORT=R4DEV:Query:1
META=r4p.name=R4HTML
META=r4p.role=application.html
META=r4p.category=data
META=module.name=R4P_R4HTML
META=description=Bounded HTML document and DOM protocol
META=feature=html-parser
META=feature=error-recovery
META=feature=document-owned-dom
META=feature=utf8-windows1252
META=feature=plain-document-view
META=feature=document-modes
META=feature=mime-routing
META=consumer=KLICKIFAX
